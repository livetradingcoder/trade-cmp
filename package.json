{
  "name": "trade-arena",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,server -c cyan,magenta \"npm run dev:web\" \"npm run dev:server\"",
    "dev:web": "npm run dev -w @trade-arena/web",
    "dev:server": "npm run dev -w @trade-arena/server",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build -w @trade-arena/web",
    "build:server": "npm run build -w @trade-arena/server",
    "lint": "npm run lint -w @trade-arena/web",
    "db:generate": "npm run db:generate -w @trade-arena/server",
    "db:push": "npm run db:push -w @trade-arena/server",
    "db:seed": "npm run db:seed -w @trade-arena/server",
    "setup": "npm install && npm run db:generate"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
